{
  "name": "@ladamczyk/structurelint",
  "version": "1.1.0",
  "description": "Standalone CLI and JavaScript API for project file/folder structure validation",
  "keywords": [
    "cli",
    "structurelint",
    "project structure",
    "folder structure",
    "file structure",
    "validation",
    "lint"
  ],
  "homepage": "https://github.com/ladamczyk-it/structurelint",
  "bugs": {
    "url": "https://github.com/ladamczyk-it/structurelint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ladamczyk-it/structurelint.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/src/index.d.ts",
  "bin": {
    "structurelint": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "rimraf ./bin ./lib && rolldown -c && tsc --emitDeclarationOnly && chmod +x ./bin/cli.js",
    "dev": "npm run build && node ./bin/cli.js",
    "husky:pre-push": "run-s qoq:check test build",
    "prepare": "husky",
    "publish:full": "run-s husky:pre-push publish:release",
    "publish:release": "npx --package semantic-release --package @semantic-release/changelog --package @semantic-release/git -y semantic-release",
    "qoq:check": "qoq --check",
    "qoq:fix": "qoq --fix",
    "sort:packages:json": "npx -y sort-package-json 'package.json'",
    "test": "vitest run",
    "test:coverage": "npm run test -- --coverage"
  },
  "dependencies": {
    "@ladamczyk/qoq-utils": "6.1.1",
    "cac": "7.0.0",
    "cosmiconfig": "9.0.2",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ladamczyk/qoq-cli": "6.1.1",
    "@ladamczyk/qoq-eslint-v9-ts": "6.1.1",
    "@ladamczyk/qoq-jscpd": "6.1.1",
    "@ladamczyk/qoq-knip": "6.1.1",
    "@ladamczyk/qoq-prettier-with-json-sort": "6.1.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "husky": "9.1.7",
    "npm-run-all": "4.1.5",
    "rimraf": "6.1.3",
    "rolldown": "1.2.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
